<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stallions.grade</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/curtisdearing/Documents/Side-Projects-Vault/20-projects/stallionsstallion/stallionsstallion/scripts/run_weekly.sh</string>
    <string>grade</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/curtisdearing/Documents/Side-Projects-Vault/20-projects/stallionsstallion/stallionsstallion</string>

  <!-- Sunday 09:00 local — pull finals, honesty report, weekly scoreboard
       recap + hypothesis ledger, close-free CLV capture, and rebuild the
       public site + hub feed LOCALLY.

       This job does NOT publish. It runs no git command at all. An earlier
       revision committed data/site and ran an unscoped `git push origin
       master` from here, unattended, which pushed every unpushed local commit
       as a side effect. Publishing is now one manual command:
       ./scripts/publish_site.sh

       Exit statuses: 0 ok · 1 a stage failed · 3 halted, inputs failed their
       health check (nothing published, nothing overwritten) · 4 the local
       site/hub build failed. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- launchd-level stdout/err. run_weekly.sh additionally writes its own
       dated per-run log to data/logs/grade_<UTCSTAMP>.log -->
  <key>StandardOutPath</key>
  <string>/Users/curtisdearing/Documents/Side-Projects-Vault/20-projects/stallionsstallion/stallionsstallion/data/logs/launchd-grade.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/curtisdearing/Documents/Side-Projects-Vault/20-projects/stallionsstallion/stallionsstallion/data/logs/launchd-grade.log</string>

  <!-- No git command runs from this job, so no credential helper is needed
       on PATH. Homebrew paths are kept because run_weekly.sh resolves
       python@3.11 through them. STALLIONS_NO_PUBLISH no longer exists: there
       is no publish step here to switch off. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
